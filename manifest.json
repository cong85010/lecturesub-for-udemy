{
  "manifest_version": 3,
  "name": "LectureSub for Udemy — Song ngữ & Từ vựng",
  "short_name": "LectureSub",
  "version": "0.3.1",
  "description": "Phụ đề song ngữ, tra và lưu từ vựng bài giảng Udemy. Miễn phí, không cần API key.",
  "minimum_chrome_version": "138",
  "permissions": ["storage"],
  "background": { "service_worker": "src/background.js" },
  "options_page": "src/options.html",
  "icons": {
    "16": "src/assets/icon-16.png",
    "32": "src/assets/icon-32.png",
    "48": "src/assets/icon-48.png",
    "128": "src/assets/icon-128.png"
  },
  "action": {
    "default_title": "LectureSub for Udemy",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "src/assets/icon-16.png",
      "32": "src/assets/icon-32.png",
      "48": "src/assets/icon-48.png",
      "128": "src/assets/icon-128.png"
    }
  },
  "content_scripts": [{
    "matches": ["https://www.udemy.com/*"],
    "js": ["src/languages.js", "src/settings.js", "src/client.js", "src/captions.js", "src/translator.js", "src/playback.js", "src/udemy-adapter.js", "src/overlay.js", "src/content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{ "resources": ["src/overlay.css"], "matches": ["https://www.udemy.com/*"] }]
}
